---
import { render } from 'astro:content';
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import Breadcrumbs from '../../../components/content/Breadcrumbs.astro';
import PostMeta from '../../../components/content/PostMeta.astro';
import PostLicense from '../../../components/content/PostLicense.astro';
import PostNavigation from '../../../components/content/PostNavigation.astro';
import RelatedPosts from '../../../components/content/RelatedPosts.astro';
import { contentTypes } from '../../../config/content';
import { defaultLocale, getLocalePath, locales, type Locale } from '../../../config/i18n';
import { siteConfig } from '../../../config/site';
import { adjacentEntries, getLocalizedEntries, entrySlug, relatedPosts, seriesPosts } from '../../../lib/content/entries';
import AudioPlayer from '../../../components/AudioPlayer.astro';
import CopyMdButton from '../../../components/CopyMdButton.astro';

export async function getStaticPaths() {
  const paths = [];
  for (const locale of locales.filter((item) => item !== defaultLocale)) {
    const posts = await getLocalizedEntries('posts', locale);
    paths.push(...posts.map((entry) => ({ params: { locale, slug: entrySlug(entry as any) }, props: { entry, locale } })));
  }
  return paths;
}

const { entry, locale } = Astro.props as any as { entry: any; locale: Locale };
const { Content, headings } = await render(entry);
const posts = await getLocalizedEntries('posts', locale);
const adjacent = adjacentEntries<'posts'>(posts, entry);
const related = relatedPosts(posts, entry, siteConfig.post.relatedCount);

const seriesEntries = entry.data.series?.length ? await getLocalizedEntries('series', locale) : [];
const seriesGroups = (entry.data.series ?? [])
  .map((slug: string) => {
    const seriesEntry = seriesEntries.find((s) => entrySlug(s as any) === slug);
    return seriesEntry ? { seriesEntry, posts: seriesPosts(posts, slug) } : undefined;
  })
  .filter((group: unknown): group is { seriesEntry: any; posts: any[] } => Boolean(group));

const siteUrl = import.meta.env.SITE;
const canonicalUrl = `${siteUrl}${getLocalePath(locale, `/posts/${entrySlug(entry)}/`)}`;
const fm = [
  '---',
  `title: ${JSON.stringify(entry.data.title)}`,
  entry.data.pubDate ? `date: ${entry.data.pubDate.toISOString().slice(0, 10)}` : '',
  entry.data.description ? `description: ${JSON.stringify(entry.data.description)}` : '',
  `tags: [${entry.data.tags.map((t: string) => JSON.stringify(t)).join(', ')}]`,
  `lang: ${locale}`,
  '---'
].filter(Boolean).join('\n');
const rawBody = `${fm}\n\n${entry.body}`;
---

<BaseLayout title={entry.data.title} description={entry.data.description} locale={locale} headings={headings} toc={entry.data.toc ?? 'center'} comments={entry.data.comments}>
  <Breadcrumbs
    locale={locale}
    items={[
      { label: siteConfig.shortName, href: getLocalePath(locale, '/'), icon: 'lucide:home' },
      { label: contentTypes.posts.label[locale], href: getLocalePath(locale, contentTypes.posts.path), icon: contentTypes.posts.icon },
      { label: entry.data.title, icon: 'lucide:file-text' }
    ]}
  />
  {entry.data.cover && (
    <div class="mb-8 overflow-hidden rounded-[var(--radius-card)]">
      <img src={entry.data.cover} alt={entry.data.title} class="aspect-video max-h-[60vh] w-full object-cover" loading="eager" />
    </div>
  )}
  <PostMeta
    title={entry.data.title}
    description={entry.data.description}
    date={entry.data.pubDate}
    locale={locale}
    tags={entry.data.tags}
    seriesGroups={seriesGroups}
    current={entry}
  />
  <article class="prose mb-12 max-w-none">
    <Content />
  </article>
  <AudioPlayer audio={entry.data.audio} />
  <CopyMdButton rawBody={rawBody} canonicalUrl={canonicalUrl} />
  <PostLicense locale={locale} />
  <PostNavigation previous={adjacent.previous} next={adjacent.next} locale={locale} />
  <RelatedPosts posts={related} locale={locale} />
</BaseLayout>
